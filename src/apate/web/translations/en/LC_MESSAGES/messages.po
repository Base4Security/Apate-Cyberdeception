msgid "Capacidad de decoys de red y host"
msgstr "Network and host decoy capability"

msgid "Capacidad de comportamiento de usuario simulado"
msgstr "Simulated user behavior capability"

msgid "Entorno de ejercicio (stack Docker)"
msgstr "Exercise environment (Docker stack)"

msgid "Servidor web"
msgstr "Web server"

msgid "Notificaciones en vivo"
msgstr "Live notifications"

msgid "Persistencia de identidades simuladas"
msgstr "Persistence of simulated identities"

msgid "Catálogos de traducción"
msgstr "Translation catalogs"

msgid "Lectura del YAML de reglas"
msgstr "Reading the rules YAML"

msgid "Exportación de informes a PDF"
msgstr "Exporting reports to PDF"

msgid "Lectura de informes de CTI en PDF"
msgstr "Reading CTI reports in PDF"

msgid "Control del runtime de contenedores"
msgstr "Container runtime control"

msgid "Llamadas HTTP salientes"
msgstr "Outgoing HTTP calls"

msgid "Generación de contenido asistida"
msgstr "Assisted content generation"

msgid "Carga de variables de entorno"
msgstr "Loading environment variables"

msgid "Lectura de registros de eventos de Windows"
msgstr "Reading Windows event logs"

msgid "Ejecución remota vía WinRM"
msgstr "Remote execution over WinRM"

msgid "Cifrado de secretos en reposo"
msgstr "Encryption of secrets at rest"

msgid "Validación de tokens OIDC"
msgstr "OIDC token validation"

msgid "Editor de reglas con resaltado (se carga desde CDN)"
msgstr "Rule editor with highlighting (loaded from a CDN)"

msgid "Cliente de notificaciones en vivo (se carga desde CDN)"
msgstr "Live notification client (loaded from a CDN)"

msgid "El archivo está vacío."
msgstr "The file is empty."

#, python-format
msgid "El archivo supera el tamaño máximo soportado (%(mb)s MB)."
msgstr "The file exceeds the maximum supported size (%(mb)s MB)."

msgid "Formato no soportado: el inventario admite solo archivos .csv."
msgstr "Format not supported: the inventory only accepts .csv files."

msgid "El CSV debe estar codificado en UTF-8."
msgstr "The CSV must be UTF-8 encoded."

msgid "El CSV no tiene una fila de encabezados."
msgstr "The CSV has no header row."

msgid "El CSV tiene encabezados duplicados."
msgstr "The CSV has duplicate headers."

#, python-format
msgid "Faltan columnas obligatorias: %(columnas)s."
msgstr "Missing required columns: %(columnas)s."

msgid "Baja"
msgstr "Low"

msgid "Media"
msgstr "Medium"

msgid "Alta"
msgstr "High"

msgid "Crítica"
msgstr "Critical"

msgid "El identificador del activo es obligatorio."
msgstr "The asset identifier is required."

msgid "El nombre del activo es obligatorio."
msgstr "The asset name is required."

msgid "El tipo del activo es obligatorio."
msgstr "The asset type is required."

#, python-format
msgid "La criticidad debe ser una de: %(opciones)s."
msgstr "Criticality must be one of: %(opciones)s."

msgid "Solo una fuente pendiente puede confirmarse."
msgstr "Only a pending source can be confirmed."

msgid "La integridad de la fuente no coincide con su huella registrada."
msgstr "The integrity of the source does not match its recorded fingerprint."

msgid "Solo una fuente activa puede archivarse."
msgstr "Only an active source can be archived."

msgid "Solo los candidatos pendientes pueden eliminarse físicamente."
msgstr "Only pending candidates can be physically deleted."

msgid "similarity_percentage debe estar entre 0 y 100"
msgstr "similarity_percentage must be between 0 and 100"

#, python-format
msgid ""
"'%(plugin_id)s' no puede ser su propio breadcrumb (leads_to_plugin_id no "
"puede coincidir con plugin_id)."
msgstr ""
"'%(plugin_id)s' cannot be its own breadcrumb (leads_to_plugin_id cannot "
"match plugin_id)."

msgid ""
"ClosureCriteria.trigger_conditions solo admite condiciones orientadas a "
"evento (event_type definido, closure_due=False) -- el cierre por "
"vencimiento ya se modela aparte con end_date/is_past_due()."
msgstr ""
"ClosureCriteria.trigger_conditions only accepts event-oriented conditions"
" (event_type set, closure_due=False) -- closure on expiry is modelled "
"separately with end_date/is_past_due()."

#, python-format
msgid ""
"Transicion no permitida: %(current)s -> %(target)s (permitidas desde "
"'%(current)s': %(allowed)s)"
msgstr ""
"Transition not allowed: %(current)s -> %(target)s (allowed from "
"'%(current)s': %(allowed)s)"

msgid "ninguna"
msgstr "none"

#, python-format
msgid "Índice de Gating Criteria fuera de rango: %(index)s."
msgstr "Gating Criteria index out of range: %(index)s."

msgid "El archivo esta vacio."
msgstr "The file is empty."

#, python-format
msgid "El archivo supera el tamano maximo soportado (%(mb)s MB)."
msgstr "The file exceeds the maximum supported size (%(mb)s MB)."

#, python-format
msgid "Formato '%(format)s' no soportado -- solo .txt y .pdf."
msgstr "Format '%(format)s' not supported -- only .txt and .pdf."

msgid "(sin extension)"
msgstr "(no extension)"

msgid "Soporte de PDF no disponible en este servidor (falta pypdf)."
msgstr "PDF support is not available on this server (pypdf is missing)."

msgid "No se pudo leer el PDF -- archivo corrupto o protegido."
msgstr "Could not read the PDF -- corrupt or protected file."

msgid "No se pudo extraer texto del PDF (¿es una imagen escaneada sin OCR?)."
msgstr "Could not extract text from the PDF (is it a scanned image without OCR?)."

#, python-format
msgid ""
"La cuenta '%(account)s' ya existe y no pertenece a esta operación de "
"APATE."
msgstr ""
"Account '%(account)s' already exists and is not owned by this APATE "
"operation."

msgid "La identidad señuelo ya existe y será reconciliada sin duplicarla."
msgstr ""
"The decoy identity already exists and will be reconciled without "
"duplication."

msgid "Crear y habilitar una identidad señuelo dentro de la OU autorizada."
msgstr "Create and enable a decoy identity inside the authorized OU."

msgid "Honeyuser creado y habilitado."
msgstr "Honeyuser created and enabled."

msgid "El honeyuser ya no existe en Active Directory."
msgstr "The honeyuser no longer exists in Active Directory."

msgid "El marcador de propiedad del honeyuser cambió."
msgstr "The honeyuser ownership marker changed."

msgid "El honeyuser fue movido fuera de la OU autorizada."
msgstr "The honeyuser was moved outside the authorized OU."

msgid "Honeyuser deshabilitado y retirado."
msgstr "Honeyuser disabled and retired."

msgid "El honeyuser está deshabilitado fuera de APATE."
msgstr "The honeyuser was disabled outside APATE."

msgid "Honeyuser presente y habilitado."
msgstr "Honeyuser is present and enabled."

msgid "Credencial del honeyuser rotada."
msgstr "Honeyuser credential rotated."

msgid "El honeyuser ya no existe."
msgstr "The honeyuser no longer exists."

msgid "Honeyuser deshabilitado y conservado para auditoría."
msgstr "Honeyuser disabled and retained for auditing."

msgid "El destino no corresponde al conector de honeyusers de AD."
msgstr "The target does not match the AD honeyuser connector."

msgid ""
"sAMAccountName debe tener entre 1 y 20 caracteres alfanuméricos, punto, "
"guion o guion bajo."
msgstr ""
"sAMAccountName must contain 1 to 20 alphanumeric, period, hyphen, or "
"underscore characters."

msgid "display_name es obligatorio y no puede superar 256 caracteres."
msgstr "display_name is required and cannot exceed 256 characters."

msgid "La OU solicitada no está en la allowlist exacta del destino."
msgstr "The requested OU is not in the target's exact allowlist."

msgid "El sufijo UPN solicitado no está autorizado para el destino."
msgstr "The requested UPN suffix is not authorized for the target."

msgid "El destino de Active Directory requiere credential_ref."
msgstr "The Active Directory target requires credential_ref."

msgid "La credencial administrativa requiere username y password."
msgstr "The administrative credential requires username and password."

msgid "El plan de honeyuser está incompleto o pertenece a otro conector."
msgstr "The honeyuser plan is incomplete or belongs to another connector."

msgid "El cambio declarado no coincide con el honeyuser planificado."
msgstr "The declared change does not match the planned honeyuser."

msgid "El registro no coincide con su plan de honeyuser."
msgstr "The record does not match its honeyuser plan."

msgid ""
"Active Directory devolvió una cuenta sin el marcador de propiedad "
"esperado."
msgstr ""
"Active Directory returned an account without the expected ownership "
"marker."

msgid "Active Directory devolvió un SID inválido para el honeyuser."
msgstr "Active Directory returned an invalid SID for the honeyuser."

msgid "Active Directory devolvió una cuenta distinta de la planificada."
msgstr "Active Directory returned an account different from the one planned."

msgid "Active Directory creó el honeyuser fuera de la OU autorizada."
msgstr "Active Directory created the honeyuser outside the authorized OU."

msgid "plan_ttl_seconds debe ser un número entero."
msgstr "plan_ttl_seconds must be an integer."

msgid "plan_ttl_seconds debe estar entre 60 y 86400."
msgstr "plan_ttl_seconds must be between 60 and 86400."

msgid "El transporte WinRM solicitado no está autorizado."
msgstr "The requested WinRM transport is not authorized."

msgid "server_cert_validation debe ser 'validate' o 'ignore'."
msgstr "server_cert_validation must be 'validate' or 'ignore'."

#, python-format
msgid "No se pudo conectar con Active Directory mediante WinRM: %(detail)s"
msgstr "Could not connect to Active Directory through WinRM: %(detail)s"

#, python-format
msgid "PowerShell remoto falló (código %(code)s): %(detail)s"
msgstr "Remote PowerShell failed (code %(code)s): %(detail)s"

msgid "PowerShell remoto devolvió una respuesta no válida."
msgstr "Remote PowerShell returned an invalid response."

msgid ""
"WinRM por HTTP está bloqueado; usá HTTPS o autorizá explícitamente "
"allow_unencrypted."
msgstr ""
"WinRM over HTTP is blocked; use HTTPS or explicitly authorize "
"allow_unencrypted."

msgid "Identificador de checkpoint inválido."
msgstr "Invalid checkpoint identifier."

msgid "El EventRecordID no puede ser negativo."
msgstr "EventRecordID cannot be negative."

#, python-format
msgid "No existe la referencia de credenciales '%(reference)s'."
msgstr "Credential reference '%(reference)s' does not exist."

msgid "La referencia de credenciales almacenada no coincide."
msgstr "The stored credential reference does not match."

msgid "La referencia de credenciales debe comenzar con 'secret://'."
msgstr "The credential reference must begin with 'secret://'."

msgid "La credencial no puede estar vacía."
msgstr "The credential cannot be empty."

#, python-format
msgid "El campo '%(field_name)s' del destino de despliegue es obligatorio."
msgstr "The deployment target field '%(field_name)s' is required."

#, python-format
msgid "Transición de despliegue inválida: %(current)s -> %(new)s."
msgstr "Invalid deployment transition: %(current)s -> %(new)s."

msgid "Identificador de despliegue inválido."
msgstr "Invalid deployment identifier."

#, python-format
msgid "No existe el plan de despliegue '%(plan_id)s'."
msgstr "Deployment plan '%(plan_id)s' does not exist."

#, python-format
msgid "No existe el registro de despliegue '%(record_id)s'."
msgstr "Deployment record '%(record_id)s' does not exist."

#, python-format
msgid "No hay un conector de despliegue registrado para '%(kind)s'."
msgstr "No deployment connector is registered for '%(kind)s'."

msgid "El conector devolvió un plan fuera del alcance solicitado."
msgstr "The connector returned a plan outside the requested scope."

msgid "El plan de despliegue venció; generá uno nuevo."
msgstr "The deployment plan expired; generate a new one."

#, python-format
msgid "El conector devolvió un estado inválido después de desplegar: %(status)s."
msgstr "The connector returned an invalid status after deployment: %(status)s."

#, python-format
msgid "Falló la ejecución del plan de despliegue '%(plan_id)s': %(detail)s"
msgstr "Deployment plan '%(plan_id)s' failed during execution: %(detail)s"

#, python-format
msgid "El conector devolvió un estado inválido al consultar: %(status)s."
msgstr "The connector returned an invalid status during inspection: %(status)s."

#, python-format
msgid ""
"Solo se puede reintentar un despliegue fallido o degradado; estado "
"actual: %(status)s."
msgstr ""
"Only a failed or degraded deployment can be retried; current status: "
"%(status)s."

#, python-format
msgid "El conector devolvió un estado inválido después del reintento: %(status)s."
msgstr "The connector returned an invalid status after retry: %(status)s."

#, python-format
msgid "Falló el reintento del despliegue '%(record_id)s': %(detail)s"
msgstr "Deployment '%(record_id)s' failed during retry: %(detail)s"

#, python-format
msgid "El conector devolvió un estado inválido después de rotar: %(status)s."
msgstr "The connector returned an invalid status after rotation: %(status)s."

#, python-format
msgid "Falló la rotación del despliegue '%(record_id)s': %(detail)s"
msgstr "Deployment '%(record_id)s' failed during rotation: %(detail)s"

#, python-format
msgid "El conector devolvió un estado inválido después de retirar: %(status)s."
msgstr "The connector returned an invalid status after retirement: %(status)s."

#, python-format
msgid "Falló el retiro del despliegue '%(record_id)s': %(detail)s"
msgstr "Deployment '%(record_id)s' failed during retirement: %(detail)s"

msgid "Identificador de destino inválido."
msgstr "Invalid deployment target identifier."

msgid "La revisión del destino cambió; volvé a cargarlo antes de guardar."
msgstr "The target revision changed; reload it before saving."

msgid "Un destino nuevo debe comenzar en la revisión 1."
msgstr "A new target must start at revision 1."

#, python-format
msgid "No existe el destino de despliegue '%(target_id)s'."
msgstr "Deployment target '%(target_id)s' does not exist."

msgid ""
"La configuración del destino no puede contener secretos; usá "
"credential_ref."
msgstr "Target configuration cannot contain secrets; use credential_ref."

msgid "La configuración OIDC está incompleta."
msgstr "The OIDC configuration is incomplete."

msgid ""
"El acceso de emergencia de OIDC requiere APATE_OIDC_EMERGENCY_EXPIRES_AT "
"con una fecha ISO-8601: una credencial que evita el inicio de sesión "
"corporativo no puede ser válida para siempre."
msgstr ""
"OIDC emergency access requires APATE_OIDC_EMERGENCY_EXPIRES_AT with an "
"ISO-8601 date: a credential that bypasses corporate sign-in cannot be "
"valid forever."

msgid "Los usuarios no administrativos requieren un equipo."
msgstr "Non-administrative users require a team."

msgid "El sujeto ya está aprovisionado."
msgstr "The subject is already provisioned."

msgid "El nombre visible no puede estar vacío."
msgstr "The display name cannot be empty."

msgid "La contraseña no puede estar vacía."
msgstr "The password cannot be empty."

msgid "Ya existe una identidad con ese nombre visible."
msgstr "An identity with that display name already exists."

msgid "Los usuarios de lectura u operación requieren un equipo."
msgstr "Read and operation users require a team."

msgid "No se puede desactivar al último administrador activo."
msgstr "The last active administrator cannot be deactivated."

msgid "El almacén de identidades tiene un formato inválido."
msgstr "The identity store has an invalid format."

#, python-format
msgid ""
"'%(kind)s' no es un proveedor de identidad registrado (disponibles: "
"%(kinds)s)."
msgstr "'%(kind)s' is not a registered identity provider (available: %(kinds)s)."

#, python-format
msgid ""
"El proveedor de identidad '%(kind)s' declara "
"authentication_mode='redirect' pero no implementa el contrato de inicio "
"por redirección: faltan authorization_url() y/o complete_authorization()."
msgstr ""
"Identity provider '%(kind)s' declares authentication_mode='redirect' but "
"does not implement the redirect login contract: authorization_url() "
"and/or complete_authorization() are missing."

#, python-format
msgid ""
"La ruta configurada para el Playground no es un directorio existente: "
"'%(path)s'."
msgstr "The configured Playground path is not an existing directory: '%(path)s'."

#, python-format
msgid ""
"'%(path)s' no contiene ningun %(candidates)s: no parece ser un checkout "
"del repositorio Cyber Deception Playground."
msgstr ""
"'%(path)s' does not contain any %(candidates)s: it does not look like a "
"checkout of the Cyber Deception Playground repository."

#, python-format
msgid "No se pudo consultar Elasticsearch en '%(url)s': %(error)s"
msgstr "Could not query Elasticsearch at '%(url)s': %(error)s"

#, python-format
msgid "El comando '%(command)s' termino con codigo %(code)s: %(stderr)s"
msgstr "Command '%(command)s' exited with code %(code)s: %(stderr)s"

msgid "(sin salida de error)"
msgstr "(no error output)"

#, python-format
msgid ""
"No se encontro el ejecutable '%(executable)s'. Verificar que Docker (con "
"el plugin 'compose') este instalado."
msgstr ""
"Executable '%(executable)s' not found. Check that Docker (with the "
"'compose' plugin) is installed."

msgid ""
"No se encontró el ejecutable 'docker'. Verificar que Docker esté "
"instalado y levantado."
msgstr "Executable 'docker' not found. Check that Docker is installed and running."

#, python-format
msgid "El comando '%(command)s' terminó con código %(code)s: %(stderr)s"
msgstr "Command '%(command)s' exited with code %(code)s: %(stderr)s"

#, python-format
msgid ""
"No se puede ejecutar '%(action)s' en estado '%(state)s' (se esperaba "
"'%(expected)s')."
msgstr "Cannot run '%(action)s' in state '%(state)s' (expected '%(expected)s')."

msgid "Comportamiento de usuario simulado"
msgstr "Simulated user behavior"

msgid ""
"Simula comportamiento de usuarios reales sobre servidores WinRM reales --"
" narrativas con perfiles de usuario y actividades asistidas por LLM."
msgstr ""
"Simulates real user behavior on real WinRM servers -- narratives with "
"user profiles and LLM-assisted activities."

msgid ""
"BudaPlugin requiere 'narrative_id' en la configuracion "
"(PluginBinding.config): el id de la Narrative de BUDA a operar."
msgstr ""
"BudaPlugin requires 'narrative_id' in the configuration "
"(PluginBinding.config): the id of the BUDA Narrative to operate."

#, python-format
msgid ""
"No se pudo conectar con el servidor de Canarytokens en '%(url)s': "
"%(error)s"
msgstr "Could not connect to the Canarytokens server at '%(url)s': %(error)s"

#, python-format
msgid "Respuesta no válida del servidor de Canarytokens: %(error)s"
msgstr "Invalid response from the Canarytokens server: %(error)s"

#, python-format
msgid "No se pudo crear el canarytoken: %(detail)s"
msgstr "Could not create the canarytoken: %(detail)s"

msgid ""
"La respuesta del servidor de Canarytokens no incluyó 'token'/'auth_token'"
" -- no se puede administrar este canarytoken sin esos dos valores."
msgstr ""
"The Canarytokens server response did not include 'token'/'auth_token' -- "
"this canarytoken cannot be managed without those two values."

#, python-format
msgid "No se pudo eliminar el canarytoken (HTTP %(status)s)."
msgstr "Could not delete the canarytoken (HTTP %(status)s)."

#, python-format
msgid "No se pudo consultar el historial del canarytoken (HTTP %(status)s)."
msgstr "Could not query the canarytoken history (HTTP %(status)s)."

msgid "Canarytokens (Thinkst)"
msgstr "Canarytokens (Thinkst)"

msgid ""
"Migas multi-superficie (cloud, documentos, DNS, QR, email...) contra un "
"servidor Canarytokens self-hosted -- detección por polling, sin webhook "
"entrante."
msgstr ""
"Multi-surface breadcrumbs (cloud, documents, DNS, QR, email...) against a"
" self-hosted Canarytokens server -- polling detection, without an inbound"
" webhook."

msgid ""
"No se puede reconciliar el estado: falta 'token'/'auth_token' en la "
"configuración (¿este canarytoken nunca se desplegó?)."
msgstr ""
"Cannot reconcile the state: 'token'/'auth_token' is missing from the "
"configuration (was this canarytoken ever deployed?)."

msgid ""
"CanarytokenPlugin requiere 'base_url' en la configuración "
"(PluginBinding.config): la URL base completa de la instancia self-hosted,"
" incluido su path de API real -- no asumas un path fijo (ver docstring de"
" apate.plugins.canarytoken_client)."
msgstr ""
"CanarytokenPlugin requires 'base_url' in the configuration "
"(PluginBinding.config): the full base URL of the self-hosted instance, "
"including its real API path -- do not assume a fixed path (see the "
"apate.plugins.canarytoken_client docstring)."

#, python-format
msgid ""
"CanarytokenPlugin requiere %(fields)s en la configuración "
"(PluginBinding.config) antes de poder crear el token. La API real de "
"Canarytokens exige 'memo' y, además, 'email' o 'webhook_url' -- APATE "
"siempre usa 'email' (nunca 'webhook_url', ver docstring del módulo)."
msgstr ""
"CanarytokenPlugin requires %(fields)s in the configuration "
"(PluginBinding.config) before it can create the token. The real "
"Canarytokens API requires 'memo' and, in addition, 'email' or "
"'webhook_url' -- APATE always uses 'email' (never 'webhook_url', see the "
"module docstring)."

msgid ""
"Este binding no tiene un canarytoken desplegado todavía (falta "
"'token'/'auth_token')."
msgstr ""
"This binding has no canarytoken deployed yet (missing "
"'token'/'auth_token')."

msgid "Decoys de red"
msgstr "Network decoys"

msgid ""
"Despliega un collector y decoys de red/host reales sobre Docker -- "
"senuelos con IP, puertos de servicio y contenido propio configurables."
msgstr ""
"Deploys a collector and real network/host decoys on Docker -- decoys with"
" configurable IP addresses, service ports, and custom content."

msgid "Honeytokens de archivo"
msgstr "File honeytokens"

msgid ""
"Coloca senuelos de archivo con credenciales ficticias y detecta acceso "
"por polling sobre sus timestamps -- el unico plugin no simulado que no "
"depende de ninguna herramienta externa."
msgstr ""
"Places decoy files with synthetic credentials and detects access by "
"polling their timestamps -- the only non-simulated plugin that does not "
"depend on external tooling."

#, python-format
msgid "No se pudo eliminar el honeytoken '%(path)s': %(error)s"
msgstr "Could not delete honeytoken '%(path)s': %(error)s"

#, python-format
msgid "No se pudo confirmar que se elimino el honeytoken '%(path)s'."
msgstr "Could not confirm that honeytoken '%(path)s' was deleted."

#, python-format
msgid ""
"No se puede restaurar el despliegue: faltan archivos configurados: "
"%(archivos)s"
msgstr "Cannot restore the deployment: configured files are missing: %(archivos)s"

msgid ""
"HoneytokenPlugin requiere 'directory' en la configuracion "
"(PluginBinding.config): la ruta donde colocar los archivos senuelo."
msgstr ""
"HoneytokenPlugin requires 'directory' in the configuration "
"(PluginBinding.config): the path where the decoy files are placed."

#, python-format
msgid ""
"Este plugin no puede generar el formato que prometen estos nombres: "
"%(nombres)s. El archivo quedaria en texto plano con una extension que no "
"le corresponde, y un adversario que lo abra o le corra 'file' descubre el"
" engano. Usa '.csv' para una tabla usuario/password o '.txt' para lineas "
"'clave: valor'."
msgstr ""
"This plugin cannot generate the format these names promise: %(nombres)s. "
"The file would be left as plain text with an extension that does not "
"match it, and an adversary who opens it or runs 'file' on it discovers "
"the deception. Use '.csv' for a user/password table or '.txt' for 'key: "
"value' lines."

#, python-format
msgid "No se pudo escribir el honeytoken '%(path)s': %(error)s"
msgstr "Could not write honeytoken '%(path)s': %(error)s"

msgid "Honeypot simulado (mock)"
msgstr "Simulated honeypot (mock)"

msgid ""
"Plugin de referencia sin infraestructura real: emite eventos sinteticos "
"de escaneo y acceso para poder ejercitar el resto del sistema (reglas, "
"telemetria, Playground) sin depender de capacidades externas."
msgstr ""
"Reference plugin without real infrastructure: emits synthetic scan and "
"access events to exercise the rest of the system (rules, telemetry, "
"Playground) without external capabilities."

msgid "El SDK 'docker' no esta disponible en este entorno."
msgstr "The 'docker' SDK is not available in this environment."

#, python-format
msgid "No se pudo conectar con Docker: %(error)s"
msgstr "Could not connect to Docker: %(error)s"

#, python-format
msgid "No se pudo desplegar el contenedor OpenCanary '%(name)s': %(error)s"
msgstr "Could not deploy OpenCanary container '%(name)s': %(error)s"

#, python-format
msgid "No se pudo reiniciar el contenedor '%(name)s': %(error)s"
msgstr "Could not restart container '%(name)s': %(error)s"

#, python-format
msgid "No se pudo retirar el contenedor '%(name)s': %(error)s"
msgstr "Could not retire container '%(name)s': %(error)s"

#, python-format
msgid "No se pudieron leer los logs de '%(name)s': %(error)s"
msgstr "Could not read the logs of '%(name)s': %(error)s"

msgid "OpenCanary (Thinkst)"
